# Copiar a .env (chmod 600) y rellenar. .env NUNCA va al repo.
#
# Clave de API del usuario dueño de las personas y de los álbumes (Jaime).
# Immich → avatar → Ajustes de la cuenta → Claves de API → Nueva clave, con SOLO estos permisos:
#   person.read, asset.read, album.read, album.create, albumAsset.create, albumAsset.delete,
#   user.read
IMMICH_API_KEY=

# Clave de la cuenta de Mari Herrero, para que sus fotos de los nietos entren en «Nietos»
# (otras_cuentas en config.json). Se crea DESDE SU CUENTA, con SOLO estos permisos:
#   person.read, asset.read, album.read, albumAsset.create
IMMICH_API_KEY_MARI=
