# Copiar a caddy/.env y rellenar. caddy/.env NO se sube al repo (.gitignore).

# IP de Tailscale del mini PC. Sale de:  tailscale ip -4
# Caddy escucha SOLO aquí. Si esto se deja vacío, escucharía en todas las
# interfaces y los servicios quedarían expuestos a la LAN: no lo dejes vacío.
TS_IP=100.x.y.z

# Token de API de Cloudflare para el reto DNS-01.
# Cloudflare → My Profile → API Tokens → Create Token → plantilla "Edit zone DNS",
# acotado a la zona ruizespana.com. Permiso necesario: Zone:DNS:Edit.
# Es un secreto: si se filtra, se revoca desde el mismo panel.
CF_API_TOKEN=

# Correo para los avisos de caducidad de Let's Encrypt.
ACME_EMAIL=
