# FASE 9 — nombres limpios con HTTPS para los servicios que NO van por el túnel NI por
# la VM pública de Oracle.
#
# Qué hace esto y qué no:
#  · Escucha SOLO en la IP de Tailscale ({$TS_IP}). Nada de esto es alcanzable desde
#    la LAN ni desde Internet: solo desde tus dispositivos del tailnet.
#  · Saca certificados de Let's Encrypt por el reto DNS-01 contra Cloudflare. El
#    dominio es público de verdad, así que el certificado es válido y se renueva solo,
#    aunque la IP a la que apunta (100.x.y.z) no sea enrutable en Internet.
#  · NO sustituye al túnel: fotos.ruizespana.com y musica.ruizespana.com siguen
#    saliendo por cloudflared con proxy naranja, para gente sin Tailscale.
#  · pelis.ruizespana.com y fotos-vpn.ruizespana.com YA NO están aquí: se hicieron
#    públicos a propósito (compartir contenido con gente sin Tailscale, p. ej. un
#    evento) detrás de la VM de Oracle — ver oracle-vps/README.md y PLAN.md §6.

{
	email {$ACME_EMAIL}
	acme_dns cloudflare {$CF_API_TOKEN}
}

# Portal de entrada. Sigue solo-Tailscale: es un panel de administración, no hay
# motivo para hacerlo público.
casa.ruizespana.com {
	bind {$TS_IP}
	reverse_proxy localhost:3000
}
