# Copiar a homepage/.env y rellenar. NO se sube al repo (.gitignore).
#
# Homepage sustituye {{HOMEPAGE_VAR_*}} en los YAML con variables del ENTORNO del
# contenedor, no con un fichero dentro de config/.

# Clave de API de Immich para el widget de la tarjeta.
# Immich → Ajustes de cuenta → Claves de API. Sin esto la tarjeta funciona igual,
# pero sin las cifras de fotos y espacio.
HOMEPAGE_VAR_IMMICH_KEY=
