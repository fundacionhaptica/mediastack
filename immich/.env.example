# Immich — copiar a .env y rellenar.  .env NO se sube a git.
# Base: https://github.com/immich-app/immich/releases/latest/download/example.env

# --- Almacenamiento -----------------------------------------------------------
# Biblioteca gestionada (subidas nuevas del móvil). Va al NAS por NFS.
UPLOAD_LOCATION=/mnt/nas/fotos

# Postgres. ext4 LOCAL. Nunca /mnt/c, nunca /mnt/nas. Esto no es negociable:
# "the Postgres database should ideally use local SSD storage, and never a network share
#  of any kind" — docs.immich.app/install/requirements
DB_DATA_LOCATION=/var/lib/mediastack/immich/postgres

# Histórico ya existente en el NAS, montado en solo lectura (ver override).
EXTERNAL_LIBRARY=/mnt/nas/fotos-historico

# --- General ------------------------------------------------------------------
TZ=Europe/Madrid

# Versión de Immich. "v3" sigue la rama v3; se puede clavar a "v3.x.y" antes de
# actualizaciones grandes para poder volver atrás.
IMMICH_VERSION=v3

# --- Base de datos ------------------------------------------------------------
# Solo A-Za-z0-9, sin caracteres especiales ni espacios (lo parte docker compose).
# Generar con:  openssl rand -hex 24
DB_PASSWORD=CAMBIAME

# No tocar de aquí para abajo
###############################################################################
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
