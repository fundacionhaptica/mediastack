# Immich — copiar a .env y rellenar.  .env NO se sube a git.
# Base: https://github.com/immich-app/immich/releases/latest/download/example.env

# --- Almacenamiento (NAS, desde 2026-10-23) -------------------------------------
# Biblioteca gestionada: subidas del móvil, miniaturas, vídeo convertido y los volcados
# automáticos de la base de datos (carpeta backups/). Carpeta compartida "Media".
UPLOAD_LOCATION=/volume1/Media

# Postgres: disco LOCAL del NAS, fuera del repo git y nunca en un recurso de red.
# "the Postgres database should ideally use local SSD storage, and never a network
#  share of any kind" — docs.immich.app/install/requirements
DB_DATA_LOCATION=/volume1/docker/mediastack-data/immich/postgres

# Histórico ya existente (Synology Photos), montado en solo lectura (ver override).
EXTERNAL_LIBRARY=/volume1/photo

# --- General ------------------------------------------------------------------
TZ=Europe/Madrid

# Versión clavada: actualizar a propósito, no por sorpresa. Al cambiarla, descargar
# los YAML oficiales de esa misma release (ver docker-compose.override.yml).
IMMICH_VERSION=v3.3.5

# --- Base de datos ------------------------------------------------------------
# Solo A-Za-z0-9, sin caracteres especiales ni espacios (lo parte docker compose).
# Generar con:  openssl rand -hex 24
DB_PASSWORD=CAMBIAME

# No tocar de aquí para abajo
###############################################################################
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
