# Copiar a .env (no se versiona) y rellenar.
TZ=Europe/Madrid

# Descargas (dentro del único recurso en el que escribe el stack, regla 6)
MIGRACION_DIR=/volume1/Media/_migracion
# Cookies/sesión de Apple de cada cuenta (datos de servicio, regla 5)
CONFIG_DIR=/volume1/docker/mediastack-data/icloudpd

# Apple ID (correo) de cada cuenta de iCloud. La contraseña NO va aquí: se mete en la web.
APPLE_ID_JAIME=
APPLE_ID_MARIA_ESPANA=
APPLE_ID_MARIA_HERRERO=
APPLE_ID_MARIA_JESUS=

# Clave de API de Immich de cada usuario (Ajustes de cuenta → Claves API), para importar.
IMMICH_KEY_JAIME=
IMMICH_KEY_MARIA_ESPANA=
IMMICH_KEY_MARIA_HERRERO=
IMMICH_KEY_MARIA_JESUS=