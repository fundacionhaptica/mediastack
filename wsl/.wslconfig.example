# Copiar a C:\Users\Admin\.wslconfig  (en Windows, NO dentro de WSL)
# Aplicar con:  wsl --shutdown   (y volver a entrar)
#
# Valores calculados para ESTE equipo: Intel N150, 4 hilos, 7,9 GB de RAM.
# Sin este fichero WSL2 reclama hasta el 80% de la RAM y Windows empieza a
# paginar justo cuando Immich está indexando. Con 8 GB no hay colchón.

[wsl2]
# 5 GB para WSL, ~3 GB para Windows. No subirlo sin haber medido antes
# cuánta RAM consume Windows en reposo en este equipo.
memory=5GB

# 3 de los 4 hilos del N150. Deja uno para que Windows respire.
processors=3

# Aquí el swap NO es un lujo: es lo que evita que el OOM killer mate Postgres
# en un pico de memoria. Va al SSD, que tiene sitio de sobra.
swap=6GB

# ---------------------------------------------------------------------------
# RED EN MODO ESPEJO — PROBADO Y DESCARTADO EL 2026-09-02
# ---------------------------------------------------------------------------
# NO PONER networkingMode=mirrored EN ESTE EQUIPO.
#
# La idea era buena: por defecto WSL2 sale por NAT y los contenedores solo se
# alcanzan desde 'localhost' del propio Windows, asi que desde otro equipo de la
# LAN no responde nadie. En modo espejo WSL comparte las IPs de Windows y eso se
# arregla — y de hecho se arreglo: 'hostname -I' dentro de WSL devolvia
# 192.168.1.227.
#
# El problema es que ROMPE LOS MONTAJES NFS DEL NAS. Los cuatro dejaron de
# funcionar: 'ls /mnt/nas/musica' daba "No such device" tras 17 segundos, con el
# NAS sirviendo NFS con normalidad. Sin montajes no hay stack.
#
# Detalle completo, con el error exacto y la vuelta atras: PASOS.md fase 8b.
# Por que no se resolvio por otra via, y que queda abierto: PLAN.md seccion 6.
#
# La linea se deja comentada a proposito, para que nadie la vuelva a poner sin
# leer antes lo que costo quitarla:
# networkingMode=mirrored

[experimental]
# Devuelve al host la RAM que WSL deja de usar (si no, se queda "pegada" tras
# un indexado grande de Immich).
autoMemoryReclaim=gradual
# El disco virtual devuelve al SSD el espacio que libera. Importante con solo
# 128 GB de disco: si no, el .vhdx crece y no baja nunca.
sparseVhd=true
